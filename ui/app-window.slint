import { ComboBox, LineEdit, ListView, SpinBox } from "std-widgets.slint";
import { Chip, Field, Icon, IconButton, MenuEntry, MenuSeparator, ProgressBar, SettingRow, SidebarItem, TabButton, Theme } from "components.slint";

export struct DownloadItem {
    id: int,
    name: string,
    progress: float,
    detail: string,
    active: bool,
    paused: bool,
    kind: string,
    state: string,
    speed-bps: int,
    path: string,
    folder: string,
    size-text: string,
    speed-text: string,
    added-text: string,
    size-kb: int,
    added-at: int,
    ext: string,
    category: string,
    status: string,
    done-text: string,
    eta-text: string,
    url: string,
    format: string,
}

export struct Category {
    id: string,
    label: string,
    count: int,
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../asset/DwV-icon.png");
    tooltip: "DwV";

    Menu {
        MenuItem {
            title: "Show DwV";
            activated => {
                root.show-window();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => {
                root.quit();
            }
        }
    }

    callback show-window();
    callback quit();

    clicked => {
        root.show-window();
    }
}

export component AppWindow inherits Window {
    title: "Download Manager";
    icon: @image-url("../asset/DwV-icon.png");
    min-width: 900px;
    min-height: 600px;
    preferred-width: 1120px;
    preferred-height: 700px;
    background: Theme.bg;
    default-font-size: 13px;

    in property <[DownloadItem]> all-downloads;
    in-out property <[DownloadItem]> downloads;
    in-out property <[Category]> status-categories;
    in-out property <[Category]> type-categories;
    in-out property <string> active-summary;
    in-out property <string> total-speed;
    in-out property <string> error-text;
    in-out property <string> save-dir-text;
    in-out property <string> filter-id: "all";
    in-out property <string> search-text;
    in-out property <bool> settings-open: false;
    in-out property <bool> add-open: false;
    in-out property <int> settings-tab: 0;
    in-out property <int> connections: 8;
    in-out property <int> speed-limit-kbps: 0;
    in-out property <int> video-quality: 0;
    in-out property <int> selected-id: 0;
    in-out property <int> selected-index: -1;
    in-out property <bool> details-open: false;
    in-out property <int> ctx-id: 0;
    in-out property <string> ctx-path;
    in-out property <string> ctx-folder;
    in-out property <bool> ctx-active: false;
    in-out property <bool> ctx-paused: false;
    in-out property <length> ctx-x: 0px;
    in-out property <length> ctx-y: 0px;

    callback add-link(string);
    callback download-video(string);
    callback download-torrent(string);
    callback pause-download(int, bool);
    callback open-item(int);
    callback show-folder(int);
    callback remove-item(int);
    callback pause-all();
    callback resume-all();
    callback choose-folder();
    callback refilter();
    callback dropped(data-transfer);
    callback save-settings();
    callback support-project();
    callback show-about();
    callback exit-app();

    DropArea {
        can-drop(event) => {
            return DragAction.copy;
        }
        dropped(event) => {
            root.dropped(event.data);
            return DragAction.copy;
        }

        HorizontalLayout {
            Rectangle {
                width: 230px;
                background: Theme.panel;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.border;
                }

                VerticalLayout {
                    padding: 14px;
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: 10px;
                        padding-left: 6px;
                        padding-bottom: 14px;
                        height: 44px;

                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 7px;
                            background: Theme.accent;
                            Text {
                                text: "D";
                                color: #ffffff;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "DwV";
                            font-size: 17px;
                            font-weight: 700;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }

                    for c in root.status-categories : SidebarItem {
                        label: c.label;
                        count: c.count;
                        active: root.filter-id == c.id;
                        dot: c.id == "all" ? Theme.accent : Theme.status-color(c.id);
                        clicked => {
                            root.filter-id = c.id;
                            root.selected-id = 0;
                            root.selected-index = -1;
                            root.details-open = false;
                            root.refilter();
                        }
                    }

                    HorizontalLayout {
                        height: 36px;
                        padding-left: 12px;
                        Text {
                            text: "File types";
                            font-size: 12px;
                            color: Theme.text-dim;
                            vertical-alignment: bottom;
                        }
                    }

                    for c in root.type-categories : SidebarItem {
                        label: c.label;
                        count: c.count;
                        active: root.filter-id == c.id;
                        dot: Theme.kind-color(c.id);
                        clicked => {
                            root.filter-id = c.id;
                            root.selected-id = 0;
                            root.selected-index = -1;
                            root.details-open = false;
                            root.refilter();
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    SidebarItem {
                        label: "Settings";
                        count: -1;
                        icon: @image-url("../asset/icons/settings.svg");
                        has-icon: true;
                        clicked => {
                            root.settings-open = true;
                        }
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;

                Rectangle {
                    height: 60px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Chip {
                                text: "Add URL";
                                primary: true;
                                icon: @image-url("../asset/icons/plus.svg");
                                has-icon: true;
                                clicked => {
                                    root.add-open = true;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Chip {
                                text: "Resume all";
                                icon: @image-url("../asset/icons/play.svg");
                                has-icon: true;
                                clicked => {
                                    root.resume-all();
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Chip {
                                text: "Pause all";
                                icon: @image-url("../asset/icons/pause.svg");
                                has-icon: true;
                                clicked => {
                                    root.pause-all();
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        VerticalLayout {
                            alignment: center;
                            LineEdit {
                                width: 240px;
                                placeholder-text: "Search downloads";
                                text: root.search-text;
                                edited(t) => {
                                    root.search-text = t;
                                    root.refilter();
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("../asset/icons/menu.svg");
                                clicked => {
                                    main-menu.show();
                                }
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                if root.error-text != "" : Rectangle {
                    height: 28px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: root.error-text;
                            color: Theme.red;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 32px;
                    background: Theme.panel;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;

                        Rectangle { width: 38px; }

                        Text {
                            text: "Name";
                            font-size: 12px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Text {
                            width: Theme.col-size;
                            text: "Size";
                            font-size: 12px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }

                        Text {
                            width: Theme.col-speed;
                            text: "Speed";
                            font-size: 12px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }

                        Text {
                            width: Theme.col-eta;
                            text: "Time left";
                            font-size: 12px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }

                        Rectangle { width: Theme.col-actions; }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;

                    ListView {
                        visible: root.downloads.length > 0;

                        for item[i] in root.downloads : Rectangle {
                            height: 64px;
                            background: root.selected-id == item.id ? Theme.accent-soft : (row-ta.has-hover ? Theme.hover : transparent);

                            row-ta := TouchArea {
                                mouse-cursor: pointer;

                                clicked => {
                                    root.selected-id = item.id;
                                    root.selected-index = i;
                                    root.details-open = true;
                                }

                                double-clicked => {
                                    root.open-item(item.id);
                                }

                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                        root.selected-id = item.id;
                                        root.selected-index = i;
                                        root.ctx-id = item.id;
                                        root.ctx-path = item.path;
                                        root.ctx-folder = item.folder;
                                        root.ctx-active = item.active;
                                        root.ctx-paused = item.paused;
                                        root.ctx-x = Math.min(row-ta.absolute-position.x + row-ta.mouse-x, root.width - 200px);
                                        root.ctx-y = Math.min(row-ta.absolute-position.y + row-ta.mouse-y, root.height - 160px);
                                        ctx-menu.show();
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 38px;
                                        height: 38px;
                                        border-radius: 8px;
                                        background: Theme.kind-color(item.category).with-alpha(0.18);
                                        Text {
                                            text: item.ext;
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: Theme.kind-color(item.category);
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: item.name;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.text;
                                        overflow: elide;
                                    }

                                    ProgressBar {
                                        value: item.progress;
                                        fill: Theme.status-color(item.status);
                                    }

                                    Text {
                                        text: item.size-text == "" ? item.done-text : item.done-text + " of " + item.size-text;
                                        font-size: 11px;
                                        color: Theme.text-dim;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    width: Theme.col-size;
                                    text: item.size-text;
                                    font-size: 12px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: Theme.col-speed;
                                    text: item.speed-text;
                                    font-size: 12px;
                                    color: item.status == "downloading" ? Theme.accent : Theme.text-dim;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: Theme.col-eta;
                                    text: item.eta-text;
                                    font-size: 12px;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }

                                HorizontalLayout {
                                    width: Theme.col-actions;
                                    spacing: 6px;
                                    alignment: end;
                                    opacity: (row-ta.has-hover || root.selected-id == item.id) ? 1.0 : 0.0;

                                    VerticalLayout {
                                        alignment: center;
                                        Chip {
                                            text: item.active ? (item.paused ? "Resume" : "Pause") : "Open";
                                            primary: item.active;
                                            icon: !item.active ? @image-url("../asset/icons/external.svg") : (item.paused ? @image-url("../asset/icons/play.svg") : @image-url("../asset/icons/pause.svg"));
                                            has-icon: true;
                                            clicked => {
                                                if (item.active) {
                                                    root.pause-download(item.id, item.paused);
                                                } else {
                                                    root.open-item(item.id);
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Chip {
                                            text: "Folder";
                                            icon: @image-url("../asset/icons/folder.svg");
                                            has-icon: true;
                                            clicked => {
                                                root.show-folder(item.id);
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.border;
                            }
                        }
                    }

                    if root.downloads.length == 0 : Rectangle {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: parent.height - 32px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 8px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: center;
                                Icon {
                                    source: @image-url("../asset/icons/download.svg");
                                    size: 40px;
                                    colorize: Theme.text-dim;
                                }
                            }

                            Text {
                                text: "Nothing here yet";
                                color: Theme.text;
                                font-size: 14px;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Drop a link or a .torrent file here, or click Add URL";
                                color: Theme.text-dim;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                if root.details-open && root.selected-index >= 0 && root.selected-index < root.downloads.length : Rectangle {
                    height: 210px;
                    background: Theme.panel;

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    VerticalLayout {
                        padding: 14px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;
                            height: 30px;

                            Text {
                                text: root.downloads[root.selected-index].name;
                                font-size: 14px;
                                font-weight: 700;
                                color: Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Chip {
                                text: "Open";
                                icon: @image-url("../asset/icons/external.svg");
                                has-icon: true;
                                enabled: root.downloads[root.selected-index].path != "" || root.downloads[root.selected-index].folder != "";
                                clicked => {
                                    root.open-item(root.downloads[root.selected-index].id);
                                }
                            }

                            Chip {
                                text: "Open folder";
                                icon: @image-url("../asset/icons/folder.svg");
                                has-icon: true;
                                enabled: root.downloads[root.selected-index].folder != "";
                                clicked => {
                                    root.show-folder(root.downloads[root.selected-index].id);
                                }
                            }

                            Chip {
                                text: "Close";
                                icon: @image-url("../asset/icons/close.svg");
                                has-icon: true;
                                clicked => {
                                    root.details-open = false;
                                }
                            }
                        }

                        ProgressBar {
                            height: 10px;
                            value: root.downloads[root.selected-index].progress;
                            fill: Theme.status-color(root.downloads[root.selected-index].status);
                        }

                        HorizontalLayout {
                            spacing: 40px;

                            VerticalLayout {
                                horizontal-stretch: 3;
                                spacing: 2px;

                                Field {
                                    label: "Status";
                                    value: root.downloads[root.selected-index].status;
                                }

                                Field {
                                    label: "Downloaded";
                                    value: root.downloads[root.selected-index].size-text == "" ? root.downloads[root.selected-index].done-text : root.downloads[root.selected-index].done-text + " of " + root.downloads[root.selected-index].size-text;
                                }

                                Field {
                                    label: "Saved to";
                                    value: root.downloads[root.selected-index].folder;
                                }

                                if root.downloads[root.selected-index].url != "" : Field {
                                    label: "Link";
                                    value: root.downloads[root.selected-index].url;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 2;
                                spacing: 2px;

                                Field {
                                    label: "Added";
                                    value: root.downloads[root.selected-index].added-text;
                                }

                                if root.downloads[root.selected-index].format != "" : Field {
                                    label: "Format";
                                    value: root.downloads[root.selected-index].format;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 40px;
                    background: Theme.panel;

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;

                        Text {
                            text: root.active-summary;
                            font-size: 12px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: root.total-speed;
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.accent;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 90px;
                        }

                        Chip {
                            text: "Support the project";
                            icon: @image-url("../asset/icons/heart.svg");
                            has-icon: true;
                            clicked => {
                                root.support-project();
                            }
                        }
                    }
                }
            }
        }
    }

    if root.add-open : Rectangle {
        background: #000000a0;

        TouchArea {
            clicked => {
                root.add-open = false;
            }
        }

        Rectangle {
            width: 520px;
            height: 300px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: 22px;
                spacing: 10px;

                Text {
                    text: "Add download";
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.text;
                }

                Text {
                    text: "Link";
                    font-size: 12px;
                    color: Theme.text-dim;
                }

                url-edit := LineEdit {
                    placeholder-text: "Paste a link — file, video or torrent, type is detected automatically";
                    edited => {
                        root.error-text = "";
                    }
                }

                Text {
                    text: "Save to";
                    font-size: 12px;
                    color: Theme.text-dim;
                }

                dir-edit := LineEdit {
                    text: root.save-dir-text;
                    edited(t) => {
                        root.save-dir-text = t;
                    }
                }

                Text {
                    text: "Folder, connections, speed limit and video quality can be changed in Settings.";
                    font-size: 12px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Chip {
                        text: "Cancel";
                        clicked => {
                            root.add-open = false;
                        }
                    }

                    Chip {
                        text: "Download";
                        primary: true;
                        clicked => {
                            if (url-edit.text != "") {
                                root.save-dir-text = dir-edit.text;
                                root.add-link(url-edit.text);
                                url-edit.text = "";
                                root.add-open = false;
                            }
                        }
                    }
                }
            }
        }
    }

    if root.settings-open : Rectangle {
        background: #000000a0;

        TouchArea {
            clicked => {
                root.settings-open = false;
            }
        }

        Rectangle {
            width: 620px;
            height: 430px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: 22px;
                spacing: 12px;

                Text {
                    text: "Settings";
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.text;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    TabButton {
                        text: "General";
                        active: root.settings-tab == 0;
                        clicked => {
                            root.settings-tab = 0;
                        }
                    }

                    TabButton {
                        text: "Speed";
                        active: root.settings-tab == 1;
                        clicked => {
                            root.settings-tab = 1;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                if root.settings-tab == 0 : VerticalLayout {
                    spacing: 6px;
                    alignment: start;

                    SettingRow {
                        title: "Default download folder";
                        hint: "New downloads are saved here";

                        HorizontalLayout {
                            spacing: 6px;

                            LineEdit {
                                width: 300px;
                                text <=> root.save-dir-text;
                            }

                            Chip {
                                text: "Browse";
                                clicked => {
                                    root.choose-folder();
                                }
                            }
                        }
                    }

                    SettingRow {
                        title: "Connections per file";
                        hint: "Segments for HTTP downloads";
                        SpinBox {
                            value <=> root.connections;
                            minimum: 1;
                            maximum: 32;
                            width: 120px;
                        }
                    }

                    SettingRow {
                        title: "Default video quality";
                        hint: "Used for new video links";
                        ComboBox {
                            model: ["Best", "1080p", "720p", "480p"];
                            current-index <=> root.video-quality;
                            width: 170px;
                        }
                    }
                }

                if root.settings-tab == 1 : VerticalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: "Speed limit in KB/s. 0 means no limit.";
                        font-size: 12px;
                        color: Theme.text-dim;
                    }

                    SettingRow {
                        title: "Download limit";
                        hint: "Applies to active downloads immediately";
                        SpinBox {
                            value <=> root.speed-limit-kbps;
                            minimum: 0;
                            maximum: 1048576;
                            width: 150px;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: end;

                    Chip {
                        text: "Done";
                        primary: true;
                        clicked => {
                            root.save-settings();
                            root.settings-open = false;
                        }
                    }
                }
            }
        }
    }

    main-menu := PopupWindow {
        x: root.width - 232px;
        y: 52px;
        width: 220px;
        height: main-menu-box.preferred-height + 12px;
        close-policy: close-on-click-outside;

        main-menu-box := Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;

            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                MenuEntry {
                    text: "Settings";
                    clicked => {
                        main-menu.close();
                        root.settings-open = true;
                    }
                }

                MenuEntry {
                    text: "Support the project";
                    clicked => {
                        main-menu.close();
                        root.support-project();
                    }
                }

                MenuEntry {
                    text: "About DwV";
                    clicked => {
                        main-menu.close();
                        root.show-about();
                    }
                }

                MenuSeparator { }

                MenuEntry {
                    text: "Exit";
                    clicked => {
                        main-menu.close();
                        root.exit-app();
                    }
                }
            }
        }
    }

    ctx-menu := PopupWindow {
        x: root.ctx-x;
        y: root.ctx-y;
        width: 200px;
        height: ctx-menu-box.preferred-height + 12px;
        close-policy: close-on-click-outside;

        ctx-menu-box := Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;

            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                MenuEntry {
                    text: "Open";
                    enabled: root.ctx-path != "" || root.ctx-folder != "";
                    clicked => {
                        ctx-menu.close();
                        root.open-item(root.ctx-id);
                    }
                }

                MenuEntry {
                    text: "Show in folder";
                    enabled: root.ctx-folder != "";
                    clicked => {
                        ctx-menu.close();
                        root.show-folder(root.ctx-id);
                    }
                }

                MenuEntry {
                    text: root.ctx-paused ? "Resume" : "Pause";
                    enabled: root.ctx-active;
                    clicked => {
                        ctx-menu.close();
                        root.pause-download(root.ctx-id, root.ctx-paused);
                    }
                }

                MenuSeparator { }

                MenuEntry {
                    text: "Remove from list";
                    danger: true;
                    clicked => {
                        ctx-menu.close();
                        root.remove-item(root.ctx-id);
                    }
                }
            }
        }
    }
}
