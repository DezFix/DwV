import { ComboBox, HorizontalBox, LineEdit, ListView, SpinBox, VerticalBox } from "std-widgets.slint";
import { FdmButton, MenuEntry, MenuSeparator, ProgressBar, Theme } from "components.slint";

export struct DownloadItem {
    id: int,
    name: string,
    progress: float,
    detail: string,
    active: bool,
    paused: bool,
    kind: string,
    state: string,
    speed-bps: int,
    path: string,
    folder: string,
    size-text: string,
    speed-text: string,
    added-text: string,
    size-kb: int,
    added-at: int,
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../asset/DwV-icon.png");
    tooltip: "DwV";

    Menu {
        MenuItem {
            title: "Show DwV";
            activated => {
                root.show-window();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => {
                root.quit();
            }
        }
    }

    callback show-window();
    callback quit();

    clicked => {
        root.show-window();
    }
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <length> cell-width: 80px;
    in property <bool> stretch: false;
    in property <bool> sorted: false;
    in property <bool> desc: false;
    callback sort();

    width: root.cell-width;
    horizontal-stretch: root.stretch ? 1 : 0;

    Text {
        text: root.sorted ? (root.desc ? root.text + " ↓" : root.text + " ↑") : root.text;
        color: Theme.muted;
        font-size: 12px;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.sort();
        }
    }
}

export component AppWindow inherits Window {
    title: "DwV";
    icon: @image-url("../asset/DwV-icon.png");
    width: 980px;
    height: 640px;
    background: Theme.bg;

    in property <[DownloadItem]> all-downloads;
    in-out property <[DownloadItem]> downloads;
    in-out property <string> error-text;
    in-out property <string> save-dir-text;
    in-out property <int> filter: 0;
    in-out property <string> search-text;
    in-out property <string> status-text;
    in-out property <bool> settings-open: false;
    in-out property <int> connections: 8;
    in-out property <int> speed-limit-kbps: 0;
    in-out property <int> video-quality: 0;
    in-out property <int> sort-key: 0;
    in-out property <bool> sort-desc: false;
    in-out property <int> selected-id: 0;
    in-out property <int> ctx-id: 0;
    in-out property <string> ctx-path;
    in-out property <string> ctx-folder;
    in-out property <bool> ctx-active: false;
    in-out property <bool> ctx-paused: false;
    in-out property <length> ctx-x: 0px;
    in-out property <length> ctx-y: 0px;

    callback add-link(string);
    callback download-video(string);
    callback download-torrent(string);
    callback pause-download(int, bool);
    callback open-item(int);
    callback show-folder(int);
    callback remove-item(int);
    callback choose-folder();
    callback refilter();
    callback dropped(data-transfer);
    callback save-settings();
    callback support-project();
    callback show-about();
    callback exit-app();

    DropArea {
        can-drop(event) => {
            return DragAction.copy;
        }
        dropped(event) => {
            root.dropped(event.data);
            return DragAction.copy;
        }

        VerticalBox {
            spacing: 0px;

            Rectangle {
                height: 52px;
                background: Theme.panel;

                HorizontalBox {
                    padding-left: 12px;
                    padding-right: 8px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    url-field := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Paste a link or drop a file — type is detected automatically";
                        edited => {
                            root.error-text = "";
                        }
                        accepted => {
                            root.add-link(self.text);
                            self.text = "";
                        }
                    }

                    FdmButton {
                        text: "+ Add";
                        primary: true;
                        clicked => {
                            if (url-field.text != "") {
                                root.add-link(url-field.text);
                                url-field.text = "";
                            }
                        }
                    }

                    search-field := LineEdit {
                        width: 180px;
                        placeholder-text: "Search…";
                        text: root.search-text;
                        edited => {
                            root.search-text = self.text;
                            root.refilter();
                        }
                    }

                    ComboBox {
                        width: 124px;
                        model: ["Newest", "Name", "Status", "Progress", "Size", "Added"];
                        current-index <=> root.sort-key;
                        selected(value) => {
                            root.sort-key = value == "Name" ? 1 : (value == "Status" ? 2 : (value == "Progress" ? 3 : (value == "Size" ? 4 : (value == "Added" ? 5 : 0))));
                            root.refilter();
                        }
                    }

                    ComboBox {
                        width: 124px;
                        model: ["All", "Active", "Paused", "Finished", "Video", "Torrent"];
                        current-index <=> root.filter;
                        selected(value) => {
                            root.filter = value == "Active" ? 1 : (value == "Paused" ? 2 : (value == "Finished" ? 3 : (value == "Video" ? 4 : (value == "Torrent" ? 5 : 0))));
                            root.refilter();
                        }
                    }

                    FdmButton {
                        text: "☰";
                        width: 34px;
                        clicked => {
                            main-menu.show();
                        }
                    }
                }
            }

            if root.settings-open : Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 8px;

                VerticalBox {
                    padding: 10px;
                    spacing: 8px;

                    HorizontalBox {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "Save to:";
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.save-dir-text;
                            color: Theme.text;
                            font-size: 13px;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        FdmButton {
                            text: "Browse…";
                            clicked => {
                                root.choose-folder();
                            }
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "Connections:";
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }

                        SpinBox {
                            minimum: 1;
                            maximum: 32;
                            value: root.connections;
                            edited(value) => {
                                root.connections = value;
                            }
                        }

                        Text {
                            text: "Speed limit (KB/s, 0 = unlimited):";
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }

                        SpinBox {
                            minimum: 0;
                            maximum: 1048576;
                            value: root.speed-limit-kbps;
                            edited(value) => {
                                root.speed-limit-kbps = value;
                            }
                        }

                        Text {
                            text: "Video quality:";
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            width: 120px;
                            model: ["Best", "1080p", "720p", "480p"];
                            current-index <=> root.video-quality;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        FdmButton {
                            text: "Save";
                            primary: true;
                            clicked => {
                                root.save-settings();
                                root.settings-open = false;
                            }
                        }
                    }
                }
            }

            if root.error-text != "" : Rectangle {
                height: 26px;

                HorizontalBox {
                    padding-left: 12px;
                    padding-right: 12px;

                    Text {
                        text: root.error-text;
                        color: Theme.danger;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 28px;
                background: Theme.panel-2;

                HorizontalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;

                    Text {
                        width: 34px;
                        text: "#";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    HeaderCell {
                        text: "Name";
                        stretch: true;
                        sorted: root.sort-key == 1;
                        desc: root.sort-desc;
                        sort() => {
                            if (root.sort-key == 1) {
                                root.sort-desc = !root.sort-desc;
                            } else {
                                root.sort-key = 1;
                                root.sort-desc = false;
                            }
                            root.refilter();
                        }
                    }

                    HeaderCell {
                        text: "Size";
                        cell-width: 80px;
                        sorted: root.sort-key == 4;
                        desc: root.sort-desc;
                        sort() => {
                            if (root.sort-key == 4) {
                                root.sort-desc = !root.sort-desc;
                            } else {
                                root.sort-key = 4;
                                root.sort-desc = false;
                            }
                            root.refilter();
                        }
                    }

                    HeaderCell {
                        text: "Status";
                        cell-width: 96px;
                        sorted: root.sort-key == 2;
                        desc: root.sort-desc;
                        sort() => {
                            if (root.sort-key == 2) {
                                root.sort-desc = !root.sort-desc;
                            } else {
                                root.sort-key = 2;
                                root.sort-desc = false;
                            }
                            root.refilter();
                        }
                    }

                    HeaderCell {
                        text: "Progress";
                        cell-width: 150px;
                        sorted: root.sort-key == 3;
                        desc: root.sort-desc;
                        sort() => {
                            if (root.sort-key == 3) {
                                root.sort-desc = !root.sort-desc;
                            } else {
                                root.sort-key = 3;
                                root.sort-desc = false;
                            }
                            root.refilter();
                        }
                    }

                    HeaderCell {
                        text: "Speed";
                        cell-width: 80px;
                    }

                    HeaderCell {
                        text: "Added";
                        cell-width: 84px;
                        sorted: root.sort-key == 5;
                        desc: root.sort-desc;
                        sort() => {
                            if (root.sort-key == 5) {
                                root.sort-desc = !root.sort-desc;
                            } else {
                                root.sort-key = 5;
                                root.sort-desc = false;
                            }
                            root.refilter();
                        }
                    }
                }
            }

            if root.downloads.length == 0 : Rectangle {
                vertical-stretch: 1;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 8px;

                VerticalBox {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "⇣";
                        color: Theme.muted;
                        font-size: 34px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Drag a link or a .torrent file here";
                        color: Theme.muted;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "or paste it into the field above";
                        color: Theme.muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }
            }

            ListView {
                vertical-stretch: 1;
                visible: root.downloads.length > 0;

                for item[i] in root.downloads : Rectangle {
                    height: 46px;
                    background: root.selected-id == item.id ? Theme.selected : (row-touch.has-hover ? Theme.row-hover : Theme.row);
                    border-radius: 4px;

                    row-touch := TouchArea {
                        mouse-cursor: pointer;

                        clicked => {
                            root.selected-id = item.id;
                        }

                        double-clicked => {
                            root.open-item(item.id);
                        }

                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                root.selected-id = item.id;
                                root.ctx-id = item.id;
                                root.ctx-path = item.path;
                                root.ctx-folder = item.folder;
                                root.ctx-active = item.active;
                                root.ctx-paused = item.paused;
                                root.ctx-x = Math.min(row-touch.absolute-position.x + row-touch.mouse-x, root.width - 210px);
                                root.ctx-y = Math.min(row-touch.absolute-position.y + row-touch.mouse-y, root.height - 180px);
                                ctx-menu.show();
                            }
                        }
                    }

                    HorizontalBox {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;

                        Text {
                            width: 34px;
                            text: "\{i + 1}";
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        VerticalBox {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 1px;

                            Text {
                                text: item.name;
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 500;
                                overflow: elide;
                            }

                            Text {
                                text: item.detail;
                                color: Theme.muted;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }

                        Text {
                            width: 80px;
                            text: item.size-text;
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Text {
                            width: 96px;
                            text: item.state;
                            color: item.state == "Finished" ? Theme.success : (item.state == "Failed" ? Theme.danger : (item.state == "Active" ? Theme.text : Theme.muted));
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        HorizontalBox {
                            width: 150px;
                            spacing: 6px;

                            VerticalBox {
                                horizontal-stretch: 1;
                                alignment: center;

                                ProgressBar {
                                    value: item.progress;
                                }
                            }

                            Text {
                                width: 34px;
                                text: "\{Math.round(item.progress * 100)}%";
                                color: Theme.muted;
                                font-size: 11px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            width: 80px;
                            text: item.speed-text;
                            color: item.active ? Theme.text : Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Text {
                            width: 84px;
                            text: item.added-text;
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: Theme.panel;

                HorizontalBox {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: root.status-text;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    FdmButton {
                        text: "Support the project";
                        clicked => {
                            root.support-project();
                        }
                    }
                }
            }
        }
    }

    main-menu := PopupWindow {
        x: root.width - 232px;
        y: 52px;
        width: 220px;
        height: main-menu-box.preferred-height + 12px;
        close-policy: close-on-click-outside;

        main-menu-box := Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;

            VerticalBox {
                padding: 6px;
                spacing: 2px;

                MenuEntry {
                    text: "Settings";
                    clicked => {
                        main-menu.close();
                        root.settings-open = !root.settings-open;
                    }
                }

                MenuEntry {
                    text: "Support the project";
                    clicked => {
                        main-menu.close();
                        root.support-project();
                    }
                }

                MenuEntry {
                    text: "About DwV";
                    clicked => {
                        main-menu.close();
                        root.show-about();
                    }
                }

                MenuSeparator { }

                MenuEntry {
                    text: "Exit";
                    clicked => {
                        main-menu.close();
                        root.exit-app();
                    }
                }
            }
        }
    }

    ctx-menu := PopupWindow {
        x: root.ctx-x;
        y: root.ctx-y;
        width: 200px;
        height: ctx-menu-box.preferred-height + 12px;
        close-policy: close-on-click-outside;

        ctx-menu-box := Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;

            VerticalBox {
                padding: 6px;
                spacing: 2px;

                MenuEntry {
                    text: "Open";
                    enabled: root.ctx-path != "" || root.ctx-folder != "";
                    clicked => {
                        ctx-menu.close();
                        root.open-item(root.ctx-id);
                    }
                }

                MenuEntry {
                    text: "Show in folder";
                    enabled: root.ctx-folder != "";
                    clicked => {
                        ctx-menu.close();
                        root.show-folder(root.ctx-id);
                    }
                }

                MenuEntry {
                    text: root.ctx-paused ? "Resume" : "Pause";
                    enabled: root.ctx-active;
                    clicked => {
                        ctx-menu.close();
                        root.pause-download(root.ctx-id, root.ctx-paused);
                    }
                }

                MenuSeparator { }

                MenuEntry {
                    text: "Remove from list";
                    clicked => {
                        ctx-menu.close();
                        root.remove-item(root.ctx-id);
                    }
                }
            }
        }
    }
}
