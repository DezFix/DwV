import { Button, ComboBox, HorizontalBox, LineEdit, ListView, SpinBox, VerticalBox } from "std-widgets.slint";

export struct DownloadItem {
    id: int,
    name: string,
    progress: float,
    detail: string,
    active: bool,
    paused: bool,
    kind: string,
    state: string,
    speed-bps: int,
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../asset/DwV-icon.png");
    tooltip: "DwV";

    Menu {
        MenuItem {
            title: "Show DwV";
            activated => {
                root.show-window();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => {
                root.quit();
            }
        }
    }

    callback show-window();
    callback quit();

    clicked => {
        root.show-window();
    }
}

export component AppWindow inherits Window {
    title: "DwV";
    icon: @image-url("../asset/DwV-icon.png");
    width: 760px;
    height: 520px;
    background: #16181d;

    in property <[DownloadItem]> all-downloads;
    in-out property <[DownloadItem]> downloads;
    in-out property <string> error-text;
    in-out property <string> save-dir-text;
    in-out property <int> filter: 0;
    in-out property <string> search-text;
    in-out property <string> status-text;
    in-out property <bool> settings-open: false;
    in-out property <int> connections: 8;
    in-out property <int> speed-limit-kbps: 0;
    in-out property <int> video-quality: 0;
    in-out property <int> sort-key: 0;
    in-out property <bool> sort-desc: false;

    callback add-link(string);
    callback download-video(string);
    callback download-torrent(string);
    callback cancel-download(int);
    callback pause-download(int, bool);
    callback choose-folder();
    callback refilter();
    callback dropped(data-transfer);
    callback save-settings();

    DropArea {
        can-drop(event) => {
            return DragAction.copy;
        }
        dropped(event) => {
            root.dropped(event.data);
            return DragAction.copy;
        }

        VerticalBox {
        padding: 14px;
        spacing: 10px;

        HorizontalBox {
            spacing: 8px;

            url-field := LineEdit {
                placeholder-text: "Paste a link or drop a file — type is detected automatically";
                edited => {
                    root.error-text = "";
                }
                accepted => {
                    root.add-link(self.text);
                    self.text = "";
                }
            }

            Button {
                text: "Add";
                clicked => {
                    if (url-field.text != "") {
                        root.add-link(url-field.text);
                        url-field.text = "";
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;

            Text {
                text: "Save to:";
                color: #98a2b3;
                vertical-alignment: center;
            }

            Text {
                text: root.save-dir-text;
                color: #e7eaf0;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            Button {
                text: "Browse…";
                clicked => {
                    root.choose-folder();
                }
            }

            Button {
                text: "Settings";
                clicked => {
                    root.settings-open = !root.settings-open;
                }
            }
        }

        if root.settings-open : Rectangle {
            border-width: 1px;
            border-color: #2b313d;
            border-radius: 8px;
            background: #1f232b;

            VerticalBox {
                HorizontalBox {
                    padding: 8px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "Connections:";
                        color: #c3c9d4;
                        vertical-alignment: center;
                    }

                    SpinBox {
                        minimum: 1;
                        maximum: 32;
                        value: root.connections;
                        edited(value) => {
                            root.connections = value;
                        }
                    }

                    Text {
                        text: "Speed limit (KB/s, 0 = unlimited):";
                        color: #c3c9d4;
                        vertical-alignment: center;
                    }

                    SpinBox {
                        minimum: 0;
                        maximum: 1048576;
                        value: root.speed-limit-kbps;
                        edited(value) => {
                            root.speed-limit-kbps = value;
                        }
                    }

                    Button {
                        text: "Save";
                        clicked => {
                            root.save-settings();
                            root.settings-open = false;
                        }
                    }
                }

                HorizontalBox {
                    padding: 8px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "Video quality:";
                        color: #c3c9d4;
                        vertical-alignment: center;
                    }

                    ComboBox {
                        width: 160px;
                        model: ["Best", "1080p", "720p", "480p"];
                        current-index <=> root.video-quality;
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 4px;

            search-field := LineEdit {
                placeholder-text: "Search";
                horizontal-stretch: 1;
                text: root.search-text;
                edited => {
                    root.search-text = self.text;
                    root.refilter();
                }
            }

            for label[i] in ["All", "Active", "Paused", "Finished", "Video", "Torrent"] : Rectangle {
                height: 30px;
                width: tab-text.preferred-width + 16px;
                border-radius: 15px;
                background: root.filter == i ? #2dd4bf : transparent;
                border-width: root.filter == i ? 0px : 1px;
                border-color: #2b313d;

                tab-text := Text {
                    text: label;
                    font-size: 12px;
                    color: root.filter == i ? #0b1215 : #98a2b3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.filter = i;
                        root.refilter();
                    }
                }
            }
        }

        if root.error-text != "" : Text {
            text: root.error-text;
            color: #f87171;
            font-size: 13px;
        }

        if root.downloads.length == 0 : Rectangle {
            vertical-stretch: 1;
            border-width: 1px;
            border-color: #2b313d;
            border-radius: 8px;
            background: #1f232b;

            Text {
                text: "Drop a link or a .torrent file here";
                color: #98a2b3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            height: 24px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;

            Rectangle {
                horizontal-stretch: 1;

                Text {
                    text: root.sort-key == 1 ? (root.sort-desc ? "Name ▼" : "Name ▲") : "Name";
                    font-size: 12px;
                    color: #98a2b3;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        if (root.sort-key == 1) {
                            root.sort-desc = !root.sort-desc;
                        } else {
                            root.sort-key = 1;
                            root.sort-desc = false;
                        }
                        root.refilter();
                    }
                }
            }

            Rectangle {
                width: 140px;

                Text {
                    text: root.sort-key == 3 ? (root.sort-desc ? "Progress ▼" : "Progress ▲") : "Progress";
                    font-size: 12px;
                    color: #98a2b3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        if (root.sort-key == 3) {
                            root.sort-desc = !root.sort-desc;
                        } else {
                            root.sort-key = 3;
                            root.sort-desc = false;
                        }
                        root.refilter();
                    }
                }
            }

            Rectangle {
                width: 84px;

                Text {
                    text: root.sort-key == 2 ? (root.sort-desc ? "Status ▼" : "Status ▲") : "Status";
                    font-size: 12px;
                    color: #98a2b3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        if (root.sort-key == 2) {
                            root.sort-desc = !root.sort-desc;
                        } else {
                            root.sort-key = 2;
                            root.sort-desc = false;
                        }
                        root.refilter();
                    }
                }
            }

            Rectangle { width: 84px; }
            Rectangle { width: 84px; }
        }

        ListView {
            vertical-stretch: 1;

            for item in root.downloads : Rectangle {
                height: 52px;
                background: #232833;
                border-radius: 6px;

                HorizontalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;

                    VerticalBox {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;

                        Text {
                            text: item.name;
                            color: #e7eaf0;
                            font-weight: 600;
                            font-size: 14px;
                            overflow: elide;
                        }

                        Text {
                            text: item.detail;
                            color: #98a2b3;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }

                    VerticalBox {
                        alignment: center;
                        width: 140px;

                        Rectangle {
                            height: 8px;
                            border-radius: 4px;
                            background: #2b313d;

                            Rectangle {
                                width: parent.width * item.progress;
                                border-radius: 4px;
                                background: #3b82f6;
                            }
                        }
                    }

                    Text {
                        width: 84px;
                        text: item.state;
                        color: #c3c9d4;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Button {
                        text: item.paused ? "Resume" : "Pause";
                        width: 84px;
                        enabled: item.active;
                        clicked => {
                            root.pause-download(item.id, item.paused);
                        }
                    }

                    Button {
                        text: "Cancel";
                        width: 84px;
                        enabled: item.active;
                        clicked => {
                            root.cancel-download(item.id);
                        }
                    }
                }
            }
        }

        HorizontalBox {
            Text {
                text: root.status-text;
                color: #98a2b3;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        }
    }
}
