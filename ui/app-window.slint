import { Button, HorizontalBox, LineEdit, ListView, VerticalBox } from "std-widgets.slint";

export struct DownloadItem {
    id: int,
    name: string,
    progress: float,
    detail: string,
    active: bool,
    paused: bool,
    kind: string,
    state: string,
}

export component AppWindow inherits Window {
    title: "DwV";
    width: 760px;
    height: 520px;

    in-out property <[DownloadItem]> downloads;
    in-out property <string> error-text;
    in-out property <string> save-dir-text;

    callback download-url(string);
    callback download-video(string);
    callback download-torrent(string);
    callback cancel-download(int);
    callback pause-download(int, bool);
    callback choose-folder();

    VerticalBox {
        padding: 14px;
        spacing: 10px;

        HorizontalBox {
            spacing: 8px;

            url-field := LineEdit {
                placeholder-text: "Paste a URL and press Download";
                edited => {
                    root.error-text = "";
                }
                accepted => {
                    root.download-url(self.text);
                    self.text = "";
                }
            }

            Button {
                text: "Download";
                clicked => {
                    if (url-field.text != "") {
                        root.download-url(url-field.text);
                        url-field.text = "";
                    }
                }
            }

            Button {
                text: "Video";
                clicked => {
                    if (url-field.text != "") {
                        root.download-video(url-field.text);
                        url-field.text = "";
                    }
                }
            }

            Button {
                text: "Torrent";
                clicked => {
                    if (url-field.text != "") {
                        root.download-torrent(url-field.text);
                        url-field.text = "";
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;

            Text {
                text: "Save to:";
                vertical-alignment: center;
            }

            Text {
                text: root.save-dir-text;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            Button {
                text: "Browse…";
                clicked => {
                    root.choose-folder();
                }
            }
        }

        if root.error-text != "" : Text {
            text: root.error-text;
            color: #c0392b;
            font-size: 13px;
        }

        if root.downloads.length == 0 : Text {
            text: "No downloads yet";
            color: #888888;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }

        ListView {
            vertical-stretch: 1;

            for item in root.downloads : Rectangle {
                height: 52px;
                background: #f4f4f6;
                border-radius: 6px;

                HorizontalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;

                    VerticalBox {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;

                        Text {
                            text: item.name;
                            color: #1f2328;
                            font-weight: 600;
                            font-size: 14px;
                            overflow: elide;
                        }

                        Text {
                            text: item.detail;
                            color: #666666;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }

                    VerticalBox {
                        alignment: center;
                        width: 140px;

                        Rectangle {
                            height: 8px;
                            border-radius: 4px;
                            background: #dcdfe6;

                            Rectangle {
                                width: parent.width * item.progress;
                                border-radius: 4px;
                                background: #3b82f6;
                            }
                        }
                    }

                    Text {
                        width: 84px;
                        text: item.state;
                        color: #444444;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Button {
                        text: item.paused ? "Resume" : "Pause";
                        visible: item.active;
                        clicked => {
                            root.pause-download(item.id, item.paused);
                        }
                    }

                    Button {
                        text: "Cancel";
                        visible: item.active;
                        clicked => {
                            root.cancel-download(item.id);
                        }
                    }
                }
            }
        }
    }
}
